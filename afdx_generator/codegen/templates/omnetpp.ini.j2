#
# Generated by afdx_generator. Edits will be overwritten on the next generation.
#
# Network: {{ project.name }}
#
[{{ config_name }}]
network = {{ network_fqn }}

# =====================================================================
# STRUCTURAL SIZING
# Port counts are the degree of each node in the topology; stream counts are the number of
# virtual links sourced by each end system. Both are inferred, not hand-entered.
# =====================================================================
{% for sw_a, sw_b in switch_pairs %}
{{ net }}.{{ sw_a.ned_ref }}.{{ profile.module_params.switch_port_count }} = {{ sw_a.params[profile.module_params.switch_port_count] }}   # {{ sw_a.label }}
{{ net }}.{{ sw_b.ned_ref }}.{{ profile.module_params.switch_port_count }} = {{ sw_b.params[profile.module_params.switch_port_count] }}   # {{ sw_b.label }} (plane B)
{% endfor %}

{% for es in wiring.end_systems %}
{% if es.params[profile.module_params.end_system_message_count] %}
{{ net }}.{{ es.ned_ref }}.{{ profile.module_params.end_system_message_count }} = {{ es.params[profile.module_params.end_system_message_count] }}   # {{ es.label }}
{% else %}
# {{ es.ned_ref }} ({{ es.label }}) is receive-only; {{ profile.module_params.end_system_message_count }} stays at its default of 0
{% endif %}
{% endfor %}

# ---- Per-switch virtual-link routing tables ----
# Both planes share a table file: the topology, and therefore the port numbering, is identical.
{% for sw_a, sw_b in switch_pairs %}
{{ net }}.{{ sw_a.ned_ref }}.{{ profile.submodules.switch_router_config_table }} = "{{ route_table_path(sw_a.node_id) }}"
{{ net }}.{{ sw_b.ned_ref }}.{{ profile.submodules.switch_router_config_table }} = "{{ route_table_path(sw_b.node_id) }}"
{% endfor %}

# =====================================================================
# GENERAL SETTINGS
# =====================================================================
{{ profile.wildcards.redundancy_checker_skew_max }} = {{ fmt_time(s.skew_max_s) }}
{{ profile.wildcards.regulator_max_queue }} = {{ s.regulator_max_vlid_queue_size }}
{{ profile.wildcards.scheduler_service_time }} = {{ fmt_time(s.scheduler_service_time_s) }}
{{ profile.wildcards.skew_max_test_enabled }} = {{ "true" if s.skew_max_test_enabled else "false" }}
{{ profile.wildcards.redundancy_copy_a }} = {{ "true" if s.redundancy_copy_to_link_a else "false" }}
{{ profile.wildcards.redundancy_copy_b }} = {{ "true" if s.redundancy_copy_to_link_b else "false" }}
{{ profile.wildcards.channel_datarate }} = {{ fmt_rate(s.channel_datarate_bps) }}
{{ profile.wildcards.channel_length }} = {{ s.channel_length_m }}m

# Technological latencies.
# NOTE: these are conventional starting values, NOT validated against a published AFDX delay
# model. Simulated end-to-end latency is sensitive to them, so treat absolute latency figures as
# provisional until these are calibrated against your reference.
{{ profile.wildcards.switch_fabric_delay }} = {{ fmt_time(s.switch_fabric_delay_s) }}
{{ profile.wildcards.latency_tech_tx }} = {{ fmt_time(s.latency_tech_tx_delay_s) }}
{{ profile.wildcards.latency_tech_rx }} = {{ fmt_time(s.latency_tech_rx_delay_s) }}

# Frame marshalling. Only {{ profile.marshall.virtual_link_id }} affects routing or timing;
# the rest are identification fields.
**.{{ profile.submodules.marshall_vector }}[*].{{ profile.marshall.network_id }} = {{ s.network_id }}
**.{{ profile.submodules.marshall_vector }}[*].{{ profile.marshall.interface_id }} = {{ s.interface_id }}
**.{{ profile.submodules.marshall_vector }}[*].{{ profile.marshall.seq_num }} = {{ s.seq_num_default }}
**.{{ profile.submodules.marshall_vector }}[*].{{ profile.marshall.udp_src_port }} = {{ s.udp_src_port }}
**.{{ profile.submodules.marshall_vector }}[*].{{ profile.marshall.udp_dest_port }} = {{ s.udp_dest_port }}
**.{{ profile.submodules.marshall_vector }}[*].{{ profile.marshall.frame_header_length }} = {{ s.frame_header_length_bytes }}

{% for es in wiring.end_systems %}
{{ net }}.{{ es.ned_ref }}.{{ profile.submodules.marshall_vector }}[*].{{ profile.marshall.equipment_id }} = {{ es.index }}
{% endfor %}

# =====================================================================
# VIRTUAL LINKS
#
# Per VL: {{ profile.source.start_time }} is the release offset, and {{ profile.marshall.bag }} is
# the minimum interval the BAG regulator enforces on the way out.
#
# {{ profile.source.inter_arrival_time }} is how often the application OFFERS a frame. For a
# periodic link that is simply the BAG. For a sporadic link it is a random expression such as
# uniform(2ms, 6ms), which the simulator redraws for every frame (the parameter is declared
# volatile in NED, and the source re-reads it before scheduling each frame).
#
# A sporadic link whose gaps can fall below its BAG is legal, but the regulator holds those frames
# back, which shows up as end-to-end latency well above the periodic case. If the *mean* gap drops
# to or below the BAG, the regulator's queue grows without bound and the run aborts.
#
# rho is the VL's sustained rate, Lmax / BAG, where Lmax is the full wire frame
# (payload + {{ s.frame_header_length_bytes }} header bytes) * 8 + {{ s.phy_overhead_bits }} bits of physical overhead.
#
# sigma is the token-bucket burst allowance: {{ s.sigma_margin_factor }} x Lmax.
# The theoretically tight value is exactly 1 x Lmax, which does NOT work in practice -- the
# policer runs at every hop, and cross-VL multiplexing on shared links perturbs a VL's spacing
# enough that a one-frame allowance underruns and frames are dropped. Raise the margin if the
# validation run reports TOKEN_INSUFFICIENT; this value is topology-dependent.
# =====================================================================
{% for vl in vl_plans %}

# ---- {{ vl.label }} ({{ vl.route_key }}): {{ vl.source_label }} -> {{ vl.destination_labels | join(", ") }}
#      route: {{ vl.path_description }}
#      arrival: {{ vl.arrival_description }}
#      frames : {{ vl.frame_size_description }}
#      Lmax = {{ vl.lmax_bits }} bits{% if not vl.rho_was_auto %} | rho set manually{% endif %}{% if not vl.sigma_was_auto %} | sigma set manually{% endif %}

{{ net }}.{{ vl.source_ref }}.{{ profile.submodules.message_source_vector }}[{{ vl.stream_index }}].{{ profile.source.packet_length }} = {{ vl.packet_length_expression }}
{{ net }}.{{ vl.source_ref }}.{{ profile.submodules.message_source_vector }}[{{ vl.stream_index }}].{{ profile.source.inter_arrival_time }} = {{ vl.arrival_expression }}
{% if vl.offset_s is not none %}
{{ net }}.{{ vl.source_ref }}.{{ profile.submodules.message_source_vector }}[{{ vl.stream_index }}].{{ profile.source.start_time }} = {{ fmt_time(vl.offset_s) }}
{% endif %}
{{ net }}.{{ vl.source_ref }}.{{ profile.submodules.message_source_vector }}[{{ vl.stream_index }}].{{ profile.source.partition_id }} = {{ vl.partition_id }}
{{ net }}.{{ vl.source_ref }}.{{ profile.submodules.message_source_vector }}[{{ vl.stream_index }}].{{ profile.source.baudrate }} = {{ fmt_rate(s.channel_datarate_bps) }}
{{ net }}.{{ vl.source_ref }}.{{ profile.submodules.message_source_vector }}[{{ vl.stream_index }}].{{ profile.source.cable_length }} = {{ s.channel_length_m }}m
{{ net }}.{{ vl.source_ref }}.{{ profile.submodules.marshall_vector }}[{{ vl.stream_index }}].{{ profile.marshall.virtual_link_id }} = {{ vl.numeric_id }}
{{ net }}.{{ vl.source_ref }}.{{ profile.submodules.marshall_vector }}[{{ vl.stream_index }}].{{ profile.marshall.bag }} = {{ fmt_time(vl.bag_s) }}
{{ net }}.{{ vl.source_ref }}.{{ profile.submodules.marshall_vector }}[{{ vl.stream_index }}].{{ profile.marshall.rho }} = {{ fmt_rate(vl.rho_bps) }}
{{ net }}.{{ vl.source_ref }}.{{ profile.submodules.marshall_vector }}[{{ vl.stream_index }}].{{ profile.marshall.sigma }} = {{ fmt_number(vl.sigma_bits) }}
{% endfor %}
