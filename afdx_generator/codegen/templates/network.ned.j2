//
// Generated by afdx_generator. Edits will be overwritten on the next generation.
//
// Network:  {{ project.name }}
// Topology: {{ wiring.end_systems | length }} end systems, {{ wiring.switches_a | length }} switches per
//           redundancy plane. Planes A and B are structurally identical mirrors of one another,
//           which is what the library's redundancy checking assumes.
//
// Per-instance parameters (switch port counts, per-end-system stream counts) and all virtual-link
// parameters live in the accompanying .ini file.
//
{% if ned_package %}package {{ ned_package }};

{% endif %}
import {{ profile.ned.end_system }};
import {{ profile.ned.switch }};
import {{ profile.ned.cable }};

network {{ network_name }}
{
    submodules:
        // End systems:
{% for es in wiring.end_systems %}
        //   [{{ es.index }}] {{ es.label }} - {{ es.params[profile.module_params.end_system_message_count] }} outgoing virtual link(s)
{% endfor %}
        {{ profile.end_system_vector_name }}[{{ wiring.end_systems | length }}]: {{ profile.ned.end_system }};

        // Switches (same index in both planes refers to the same logical switch):
{% for sw in wiring.switches_a %}
        //   [{{ sw.index }}] {{ sw.label }} - {{ sw.params[profile.module_params.switch_port_count] }} port(s)
{% endfor %}
        {{ profile.switch_plane_a_vector_name }}[{{ wiring.switches_a | length }}]: {{ profile.ned.switch }};
        {{ profile.switch_plane_b_vector_name }}[{{ wiring.switches_b | length }}]: {{ profile.ned.switch }};

    connections:
{% for plane in ["A", "B"] %}
        // ---- Redundancy plane {{ plane }} ----
{% for conn in wiring.connections if conn.plane == plane %}
        {{ conn.a.module_ref }}.{{ conn.a.gate }} <--> {{ profile.ned.cable }} <--> {{ conn.b.module_ref }}.{{ conn.b.gate }}; // {{ conn.comment }}
{% endfor %}
{% endfor %}
}
